        local target = GetClosestPlayerAimbot()
        if target and isTargetValid(target) and target.Character then
            local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if head then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
            end
        end
    end

    if OrbitActive then
        local target = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if isTargetValid(p) then target = p break end
        end
        if target and isTargetValid(target) and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = target.Character.HumanoidRootPart
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local angle = (tickCount * (OrbitSpeed * 0.05)) * OrbitAngle
                myRoot.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, OrbitHeight, OrbitStuds)
            end
        else
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local spamOffset = Vector3.new(math.random(-5937473, 5937473), math.random(1000, 5000), math.random(-5937473, 5937473))
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(spamOffset) * CFrame.Angles(math.rad(tickCount * 393818), 0, 0)
            end
        end
    end

    if RagebotEnabled then
        local target = nil
        if AutoPrioridadEnabled or PriorizedVoidAttacks then
            local prioritized = GetPrioritizedTarget()
            if prioritized then
                target = prioritized
                if CurrentPrioritizedPlayer ~= prioritized and (tick() - lastNotifyTime) > 1.5 then
                    CurrentPrioritizedPlayer = prioritized
                    lastNotifyTime = tick()
                    Library:Notify("PRIORIZED TO " .. string.upper(prioritized.Name), 3)
                end
            else
                target = GetClosestTargetPlayer()
                CurrentPrioritizedPlayer = nil
            end
        else
            target = GetClosestTargetPlayer()
            CurrentPrioritizedPlayer = nil
        end

        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            if target and isTargetValid(target) and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local tHrp = target.Character.HumanoidRootPart
                local tHead = target.Character:FindFirstChild("Head") or tHrp

                if RageMode == "GUN" then
                    local desiredCFrame = AntiKnifeEnabled and (tHrp.CFrame * CFrame.new(2.5, 0, 0)) or (tHrp.CFrame * CFrame.new(0, 0, 2.5))
                    ApplyFakePosition(myRoot, desiredCFrame)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
                elseif RageMode == "MELE" then
                    if lastMeleTarget ~= target then
                        lastMeleTarget = target
                        meleCurrentPhase = 1
                        meleStateTimer = tick()
                    end
                    local elapsed = tick() - meleStateTimer
                    if meleCurrentPhase == 1 then
                        ApplyFakePosition(myRoot, tHrp.CFrame * CFrame.new(0, 0, 1.5))
                        if elapsed >= 0.45 then
                            meleCurrentPhase = 2
                            meleStateTimer = tick()
                        end
                    elseif meleCurrentPhase == 2 then
                        local voidOffset = Vector3.new(math.random(-9000000, 9000000), 9000000, math.random(-9000000, 9000000))
                        ApplyFakePosition(myRoot, CFrame.new(voidOffset) * CFrame.Angles(math.rad(tickCount * 900000), 0, 0))
                        if elapsed >= 0.50 then
                            meleCurrentPhase = 1
                            meleStateTimer = tick()
                        end
                    end
                elseif RageMode == "KNIFE" then
                    local lateralOffset = math.sin(tickCount * 5000000 * 0.01) * 3.5
                    ApplyFakePosition(myRoot, tHrp.CFrame * CFrame.new(lateralOffset, 0, 2))
                end
            else
                lastMeleTarget = nil
                meleCurrentPhase = 1
                meleStateTimer = tick()
                local spamOffset = Vector3.new(math.random(-9000000, 9000000), math.random(1000, 9000000), math.random(-9000000, 9000000))
                ApplyFakePosition(myRoot, CFrame.new(spamOffset) * CFrame.Angles(math.rad(tickCount * 900000), 0, 0))
            end
        end
    end

    -- Loop de Renderizado ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not espCache[plr] then
                espCache[plr] = createDrawingObjects()
            end

            local objs = espCache[plr]
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChild("Humanoid")
            local head = char and char:FindFirstChild("Head")

            local isTeam = false
            if ESP_Settings.TeamCheckESP then
                local myT, thrT = LocalPlayer:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
                if myT ~= nil and thrT ~= nil then isTeam = (tostring(myT) == tostring(thrT))
                elseif LocalPlayer.Team and plr.Team then isTeam = (LocalPlayer.Team == plr.Team) end
            end

            local show = char and root and humanoid and humanoid.Health > 0 and not isTeam

            if show then
                local vector, onScreen = Camera:WorldToViewportPoint(root.Position)

                if ESP_Settings.ChamsHighlight then
                    if not char:FindFirstChild("ApocHighlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "ApocHighlight"
                        hl.Adornee = char
                        hl.Parent = char
                    end
                    local hl = char:FindFirstChild("ApocHighlight")
                    hl.FillColor = ESP_Settings.ChamsColor
                    hl.OutlineColor = Color3.fromRGB(0,0,0)
                    hl.Enabled = true
                else
                    if char:FindFirstChild("ApocHighlight") then
                        char.ApocHighlight.Enabled = false
                    end
                end

                if onScreen then
                    local hrpPos = root.Position
                    local topPos = hrpPos + Vector3.new(0, 3, 0)
                    local botPos = hrpPos - Vector3.new(0, 3.5, 0)
                    
                    local topVector = Camera:WorldToViewportPoint(topPos)
                    local botVector = Camera:WorldToViewportPoint(botPos)
                    local h = math.abs(topVector.Y - botVector.Y)
                    local w = h / 2
                    local x = vector.X - w / 2
                    local y = topVector.Y

                    if ESP_Settings.Box then
                        objs.Box.Visible = true
                        objs.Box.Position = Vector2.new(x, y)
                        objs.Box.Size = Vector2.new(w, h)
                        objs.Box.Color = ESP_Settings.BoxColor
                    else
                        objs.Box.Visible = false
                    end

                    if ESP_Settings.FilledBox then
                        objs.FilledBox.Visible = true
                        objs.FilledBox.Position = Vector2.new(x, y)
                        objs.FilledBox.Size = Vector2.new(w, h)
                        objs.FilledBox.Color = ESP_Settings.FilledBoxColor
                        objs.FilledBox.Transparency = ESP_Settings.FilledBoxTrans / 100
                    else
                        objs.FilledBox.Visible = false
                    end

                    if ESP_Settings.Name then
                        objs.Name.Visible = true
                        objs.Name.Text = plr.Name
                        objs.Name.Position = Vector2.new(vector.X, y - 16)
                        objs.Name.Color = ESP_Settings.NameColor
                        objs.Name.Outline = ESP_Settings.TextShadow
                    else
                        objs.Name.Visible = false
                    end

                    if ESP_Settings.HealthBar and humanoid then
                        local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        local barHeight = h * healthPercent
                        objs.HealthBarBg.Visible = true
                        objs.HealthBarBg.Position = Vector2.new(x - 6, y)
                        objs.HealthBarBg.Size = Vector2.new(3, h)
                        objs.HealthBarBg.Color = Color3.fromRGB(0, 0, 0)
                        objs.HealthBarBg.Filled = true

                        objs.HealthBar.Visible = true
                        objs.HealthBar.Position = Vector2.new(x - 5, y + (h - barHeight))
                        objs.HealthBar.Size = Vector2.new(1, barHeight)
                        objs.HealthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                        objs.HealthBar.Filled = true
                    else
                        objs.HealthBarBg.Visible = false
                        objs.HealthBar.Visible = false
                    end

                    if ESP_Settings.HealthText and humanoid then
                        objs.HealthText.Visible = true
                        objs.HealthText.Text = math.floor(humanoid.Health) .. "HP"
                        objs.HealthText.Position = Vector2.new(x - 22, y + (h / 2))
                        objs.HealthText.Color = ESP_Settings.HealthTextColor
                        objs.HealthText.Outline = ESP_Settings.TextShadow
                    else
                        objs.HealthText.Visible = false
                    end

                    if ESP_Settings.Skeleton and head and char:FindFirstChild("UpperTorso") then
                        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                        local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                        local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                        local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                        local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

                        local function connectBones(p1, p2, lineIdx)
                            if p1 and p2 and objs.SkeletonLines[lineIdx] then
                                local v1, on1 = Camera:WorldToViewportPoint(p1.Position)
                                local v2, on2 = Camera:WorldToViewportPoint(p2.Position)
                                if on1 and on2 then
                                    objs.SkeletonLines[lineIdx].Visible = true
                                    objs.SkeletonLines[lineIdx].From = Vector2.new(v1.X, v1.Y)
                                    objs.SkeletonLines[lineIdx].To = Vector2.new(v2.X, v2.Y)
                                    objs.SkeletonLines[lineIdx].Color = ESP_Settings.SkeletonColor
                                    return
                                end
                            end
                            if objs.SkeletonLines[lineIdx] then objs.SkeletonLines[lineIdx].Visible = false end
                        end

                        connectBones(head, torso, 1)
                        connectBones(torso, leftArm, 2)
                        connectBones(torso, rightArm, 3)
                        connectBones(torso, leftLeg, 4)
                        connectBones(torso, rightLeg, 5)
                    else
                        for _, l in ipairs(objs.SkeletonLines) do l.Visible = false end
                    end

                    if ESP_Settings.HeadDot and head then
                        local headV, headOn = Camera:WorldToViewportPoint(head.Position)
                        if headOn then
                            objs.HeadDot.Visible = true
                            objs.HeadDot.Position = Vector2.new(headV.X, headV.Y)
                            objs.HeadDot.Radius = ESP_Settings.HeadDotRadius
                            objs.HeadDot.Color = ESP_Settings.HeadDotColor
                            objs.HeadDot.Filled = true
                        else
                            objs.HeadDot.Visible = false
                        end
                    else
                        objs.HeadDot.Visible = false
                    end

                    if ESP_Settings.Tracers then
                        objs.Tracer.Visible = true
                        objs.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        objs.Tracer.To = Vector2.new(vector.X, vector.Y)
                        objs.Tracer.Color = ESP_Settings.TracerColor
                    else
                        objs.Tracer.Visible = false
                    end

                    if ESP_Settings.Distance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude
                        objs.Distance.Visible = true
                        objs.Distance.Text = math.floor(dist) .. " studs"
                        objs.Distance.Position = Vector2.new(vector.X, y + h + 2)
                        objs.Distance.Color = ESP_Settings.DistanceColor
                        objs.Distance.Outline = ESP_Settings.TextShadow
                    else
                        objs.Distance.Visible = false
                    end

                    if ESP_Settings.WeaponESP then
                        local tool = char:FindFirstChildOfClass("Tool")
                        objs.WeaponText.Visible = true
                        objs.WeaponText.Text = tool and tool.Name or "None"
                        objs.WeaponText.Position = Vector2.new(vector.X, y + h + 14)
                        objs.WeaponText.Color = ESP_Settings.WeaponColor
                        objs.WeaponText.Outline = ESP_Settings.TextShadow
                    else
                        objs.WeaponText.Visible = false
                    end

                    objs.OffscreenArrow.Visible = false
                else
                    if ESP_Settings.OffscreenArrows then
                        local camPos = Camera.CFrame.Position
                        local relPos = root.Position - camPos
                        local camLook = Camera.CFrame.LookVector
                        local camRight = Camera.CFrame.RightVector
                        
                        local fwdDot = relPos:Dot(camLook)
                        local rightDot = relPos:Dot(camRight)
                        local angle = math.atan2(rightDot, fwdDot)
                        
                        local center = Camera.ViewportSize / 2
                        local radius = ESP_Settings.ArrowRadius
                        local arrowX = center.X + math.cos(angle - math.pi/2) * radius
                        local arrowY = center.Y + math.sin(angle - math.pi/2) * radius
                        
                        objs.OffscreenArrow.Visible = true
                        objs.OffscreenArrow.PointA = Vector2.new(arrowX, arrowY)
                        objs.OffscreenArrow.PointB = Vector2.new(arrowX - 10, arrowY + 15)
                        objs.OffscreenArrow.PointC = Vector2.new(arrowX + 10, arrowY + 15)
                        objs.OffscreenArrow.Color = ESP_Settings.ArrowColor
                    else
                        objs.OffscreenArrow.Visible = false
                    end

                    objs.Box.Visible = false
                    objs.FilledBox.Visible = false
                    objs.Name.Visible = false
                    objs.HealthBarBg.Visible = false
                    objs.HealthBar.Visible = false
                    objs.HealthText.Visible = false
                    for _, l in ipairs(objs.SkeletonLines) do l.Visible = false end
                    objs.HeadDot.Visible = false
                    objs.Tracer.Visible = false
                    objs.Distance.Visible = false
                    objs.WeaponText.Visible = false
                end
            else
                objs.Box.Visible = false
                objs.FilledBox.Visible = false
                objs.Name.Visible = false
                objs.HealthBarBg.Visible = false
                objs.HealthBar.Visible = false
                objs.HealthText.Visible = false
                for _, l in ipairs(objs.SkeletonLines) do l.Visible = false end
                objs.HeadDot.Visible = false
                objs.Tracer.Visible = false
                objs.Distance.Visible = false
                objs.OffscreenArrow.Visible = false
                objs.WeaponText.Visible = false
                if char and char:FindFirstChild("ApocHighlight") then
                    char.ApocHighlight.Enabled = false
                end
            end
        end
    end
end)

