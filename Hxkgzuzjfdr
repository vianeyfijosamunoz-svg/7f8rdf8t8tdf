local function createDrawingObjects()
    local objs = {
        Box = Drawing.new("Square"),
        CornerLines = {},
        FilledBox = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        HealthBarBg = Drawing.new("Square"),
        HealthBar = Drawing.new("Square"),
        HealthText = Drawing.new("Text"),
        SkeletonLines = {},
        HeadDot = Drawing.new("Circle"),
        Tracer = Drawing.new("Line"),
        Distance = Drawing.new("Text"),
        OffscreenArrow = Drawing.new("Triangle"),
        WeaponText = Drawing.new("Text"),
        InfoText = Drawing.new("Text"),
        LookAtLine = Drawing.new("Line"),
        Box3DLines = {}
    }

    objs.Box.Thickness = 1.5; objs.Box.Filled = false
    objs.FilledBox.Thickness = 1; objs.FilledBox.Filled = true
    objs.Name.Size = 13; objs.Name.Center = true
    objs.HealthText.Size = 11; objs.HealthText.Center = true
    objs.Distance.Size = 11; objs.Distance.Center = true
    objs.WeaponText.Size = 11; objs.WeaponText.Center = true
    objs.InfoText.Size = 11; objs.InfoText.Center = true

    for i = 1, 12 do
        local l = Drawing.new("Line")
        l.Thickness = 1.5
        table.insert(objs.CornerLines, l)
    end

    for i = 1, 6 do
        local l = Drawing.new("Line")
        l.Thickness = 1.5
        table.insert(objs.SkeletonLines, l)
    end

    objs.HeadDot.NumSides = 16
    objs.Tracer.Thickness = 1.5
    objs.OffscreenArrow.Filled = true
    objs.OffscreenArrow.Thickness = 1
    objs.LookAtLine.Thickness = 1.5

    for i = 1, 12 do
        local l = Drawing.new("Line")
        l.Thickness = 1
        table.insert(objs.Box3DLines, l)
    end

    return objs
end

local function removeDrawingObjects(objs)
    for _, v in pairs(objs) do
        if typeof(v) == "userdata" then
            pcall(function() v:Remove() end)
        elseif type(v) == "table" then
            for _, subV in pairs(v) do
                pcall(function() subV:Remove() end)
            end
        end
    end
end

